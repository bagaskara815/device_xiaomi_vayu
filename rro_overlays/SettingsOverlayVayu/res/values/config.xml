<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Whether to show min/max refresh rate in display settings -->
    <bool name="config_show_refresh_rate_switch">true</bool>

    <!-- Whether or not the device is capable of multiple levels of vibration intensity. -->
    <bool name="config_vibration_supports_multiple_intensities">true</bool>

    <!-- Device specific doze package -->
    <string name="config_customDozePackage">org.lineageos.settings/org.lineageos.settings.doze.DozeSettingsActivity</string>

    <!-- Whether to show peak refresh rate in display settings -->
    <bool name="config_show_peak_refresh_rate_switch">true</bool>

    <!-- Whether to show min refresh rate in display settings -->
    <bool name="config_show_min_refresh_rate_switch">true</bool>

    <!-- Whether to show Smooth Display feature in Settings Options -->
    <bool name="config_show_smooth_display">true</bool>
</resources>
